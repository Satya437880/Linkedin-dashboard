# Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Login password for the dashboard. Use a long random value.
APP_PASSWORD=
# 32+ random characters, signs the session cookie.
SESSION_SECRET=
# Shared secret the browser extension sends as x-ingest-token.
INGEST_TOKEN=
# Lets you set a new password at /reset. 12+ random characters, keep it somewhere safe.
RECOVERY_CODE=
# Vercel Cron sends this as a Bearer token to /api/cron/jobs.
CRON_SECRET=

OWNER_NAME=Maple MPSS Team
APP_TIMEZONE=America/Toronto

# Optional: local Ollama model for pasted-text extraction. Not reachable from Vercel, rules are used instead.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
